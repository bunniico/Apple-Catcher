1 HOME:NORMAL:GOTO 200
10 GOSUB 40
20 GOSUB 70:GOSUB 90:GOSUB 100:GOSUB 110:GOSUB 120:IF L<1 THEN GOTO 150
25 GOSUB 80:GOSUB 70:GOTO 20
40 HOME:NORMAL:S=0:T=16:HI=0:L=3:AX=20:AY=1:ALY=1:X=20:GOSUB 129:RETURN
70 K=PEEK(49152):IF K=136 THEN X=10
71 IF K=138 THEN X=20
72 IF K=149 THEN X=30
73 RETURN
80 FOR N=1 TO T:NEXT N:NORMAL:RETURN
90 HTAB AX:VTAB ALY:PRINT " ":HTAB AX:VTAB AY:PRINT "O":RETURN
100 IF X><10 THEN HTAB 10:VTAB 23:PRINT " "
101 IF X><20 THEN HTAB 20:VTAB 23:PRINT " "
102 IF X><30 THEN HTAB 30:VTAB 23:PRINT " "
103 HTAB X:VTAB 23:PRINT "U":RETURN
110 ALY=AY:AY=AY+1:RETURN
120 IF AY><23 THEN RETURN
121 AY=1:IF AX=X THEN S=S+100:NORMAL
122 IF AX><X THEN L=L-1
123 T=T-64:IF T<128 THEN T=128
124 RX=RND(1)*10
125 HOME:GOSUB 129
126 IF RX<3 THEN AX=10:RETURN
127 IF RX>=3 AND RX<7 THEN AX=20:RETURN
128 AX=30:RETURN
129 HTAB 1:VTAB 1:PRINT "SCORE":HTAB 7:VTAB 1:PRINT S:HTAB 34:VTAB 1:PRINT "LIVES":HTAB 40:VTAB 1:PRINT L:RETURN
150 NORMAL:HOME
151 IF S<=HI THEN HTAB 16:VTAB 2:FLASH:PRINT "TRY AGAIN":NORMAL
152 IF S>HI THEN HI=S:HTAB 14:VTAB 2:FLASH:PRINT "NEW HIGHSCORE":NORMAL
153 HTAB 13:VTAB 23:PRINT "MADE BY ELLIE :)":HTAB 14:VTAB 8:PRINT "SCORE ":HTAB 24:VTAB 8:PRINT S:HTAB 14:VTAB 12:PRINT "HIGHS ":HTAB 24:VTAB 12:PRINT HI
154 INVERSE:HTAB 16:VTAB 20:INPUT "CONTINUE?";C$:NORMAL:GOTO 160
160 S=0:T=16:L=3:HOME:GOSUB 129:GOTO 20
200 HTAB 15:VTAB 4:PRINT "Apple Catcher":HTAB 1:VTAB 5:PRINT "----------------------------------------"
201 FLASH:HTAB 12:VTAB 8:PRINT "ARROW KEYS TO MOVE":NORMAL:HTAB 13:VTAB 12:PRINT "CATCH THE APPLES"
202 INPUT "";C$:GOTO 10
